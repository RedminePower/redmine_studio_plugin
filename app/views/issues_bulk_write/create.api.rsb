# 成功した issue の reply_items / children_items / 最終更新者・最新コメントを一括プリロードして N+1 を避ける
succeeded_issues = @results.select { |r| r[:success] }.map { |r| r[:issue] }
Issue.load_reply_items(succeeded_issues)
Issue.load_children_counts(succeeded_issues)
Issue.load_visible_last_updated_by(succeeded_issues)
Issue.load_visible_last_notes(succeeded_issues)
Issue.load_spent_hours_by_user(succeeded_issues)

api.array :results do
  @results.each do |result|
    api.result do
      api.index result[:index]
      api.op result[:op]
      api.success result[:success]
      if result[:success]
        issue = result[:issue]
        api.issue do
          api.id issue.id
          api.project(:id => issue.project_id, :name => issue.project.name) unless issue.project.nil?
          api.tracker(:id => issue.tracker_id, :name => issue.tracker.name) unless issue.tracker.nil?
          api.status(:id => issue.status_id, :name => issue.status.name, :is_closed => issue.status.is_closed) unless issue.status.nil?
          api.priority(:id => issue.priority_id, :name => issue.priority.name) unless issue.priority.nil?
          api.author(:id => issue.author_id, :name => issue.author.name) unless issue.author.nil?
          api.assigned_to(:id => issue.assigned_to_id, :name => issue.assigned_to.name) unless issue.assigned_to.nil?
          api.category(:id => issue.category_id, :name => issue.category.name) unless issue.category.nil?
          api.fixed_version(:id => issue.fixed_version_id, :name => issue.fixed_version.name) unless issue.fixed_version.nil?
          api.parent(:id => issue.parent_id) unless issue.parent.nil?

          api.subject issue.subject
          api.description issue.description
          api.start_date issue.start_date
          api.due_date issue.due_date
          api.done_ratio issue.done_ratio
          api.is_private issue.is_private
          api.estimated_hours issue.estimated_hours
          api.total_estimated_hours issue.total_estimated_hours
          if User.current.allowed_to?(:view_time_entries, issue.project)
            api.spent_hours(issue.spent_hours)
            api.total_spent_hours(issue.total_spent_hours)
          end

          render_api_custom_values issue.visible_custom_field_values, api

          api.created_on issue.created_on
          api.updated_on issue.updated_on
          api.closed_on issue.closed_on

          # redmine_studio_plugin: reply_count / children_count を返す
          # count は件数、items は表示の元情報 (reply: 担当者の遷移、children: 子チケット先頭 10 件)。
          # 整形 (ラベル化・省略・他N件) はクライアント側の責務とする。
          api.reply_count do
            api.count issue.reply_count_value
            api.array :items do
              issue.reply_items.each do |item|
                api.item(:id => item[:id], :name => item[:name])
              end
            end
          end
          api.children_count do
            api.count issue.children_count_value
            api.array :items do
              issue.children_items.each do |item|
                api.item(:id => item[:id], :name => item[:name])
              end
            end
          end

          # redmine_studio_plugin: 最終更新者 / 最新コメントを返す (core の last_updated_by / last_notes を利用)
          last_updated_by = issue.last_updated_by
          api.last_updated_by(:id => last_updated_by.id, :name => last_updated_by.name) if last_updated_by.present?
          api.last_notes issue.last_notes

          # redmine_studio_plugin: 担当者(ユーザー)ごとの subtree 作業時間を返す
          # アプリは担当者切り替え時にこの配列から工数を引き、per-issue の作業時間再取得を避ける。
          api.array :spent_hours_by_user do
            issue.spent_hours_by_user_items.each do |item|
              api.item(:user_id => item[:user_id], :hours => item[:hours])
            end
          end
        end
      else
        api.array :errors do
          result[:errors].each do |msg|
            api.error msg
          end
        end
      end
    end
  end
end
