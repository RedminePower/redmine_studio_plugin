<%# ロードマップ一覧画面（全バージョン）のバージョンごとの差し込み。標準と同じく、サイドバーのトラッカーとサブプロジェクトの絞り込みに従う %>
<% display = RoadmapDisplay.for_project(version.project) %>
<% if display && @project %>
<%
  project_ids = @with_subprojects ? @project.self_and_descendants.pluck(:id) : [@project.id]
  tracker_ids = @selected_tracker_ids || []
%>
<div class="rsp-roadmap-display-block" data-keep-standard="<%= display.keep_standard_list ? '1' : '0' %>">
  <% if tracker_ids.any? %>
    <%= render :partial => 'roadmap_displays/issue_list',
               :locals => {:roadmap_display => display, :version => version,
                           :tracker_ids => tracker_ids, :project_ids => project_ids, :hide_when_empty => true} %>
  <% end %>
</div>
<%= javascript_tag do %>
$(function() {
  $('.rsp-roadmap-display-block:not(.rsp-placed)').each(function() {
    var block = $(this).addClass('rsp-placed');
    var standard = block.closest('article').find('table.related-issues').closest('form');
    if (standard.length) {
      block.insertBefore(standard);
      if (block.data('keep-standard') != 1) { standard.hide(); }
    }
  });
});
<% end %>
<% end %>
