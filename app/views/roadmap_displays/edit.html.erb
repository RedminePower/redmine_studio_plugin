<%= title [l(:rd_label_roadmap_display), roadmap_displays_path], @roadmap_display.name %>

<%= labelled_form_for :roadmap_display, @roadmap_display,
        :url => roadmap_display_path(@roadmap_display),
        :html => {:method => :put, :id => 'roadmap_display-form'} do |f| %>
  <%= render :partial => 'roadmap_displays/form', :locals => {:form => f} %>
  <%= f.submit l(:button_save) %>
  <%= link_to l(:button_cancel), roadmap_displays_path %>
<% end %>

