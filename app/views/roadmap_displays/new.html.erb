<%= title [l(:rd_label_roadmap_display), roadmap_displays_path], l(:rd_label_new) %>

<%= labelled_form_for :roadmap_display, @roadmap_display,
        :url => roadmap_displays_path,
        :html => {:id => 'roadmap_display-form'} do |f| %>
  <%= render :partial => 'roadmap_displays/form', :locals => {:form => f} %>
  <%= f.submit l(:button_create) %>
  <%= link_to l(:button_cancel), roadmap_displays_path %>
<% end %>

