<% display = RoadmapDisplay.for_project(version.project) %>
<% if display %>
<div id="rsp-roadmap-display-block" style="display:none">
  <%= render :partial => 'roadmap_displays/issue_list', :locals => {:roadmap_display => display, :version => version} %>
</div>
<%= javascript_tag do %>
$(function() {
  var block = $('#rsp-roadmap-display-block');
  var standard = $('#roadmap table.related-issues').closest('form');
  if (standard.length) {
    block.insertBefore(standard);
  } else {
    block.appendTo('#roadmap');
  }
  block.show();
});
<% end %>
<% end %>
